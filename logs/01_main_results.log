. *--------------------------------------------------------------
. * Table 3  优酷评论（Table 3 与 Table S6）
. *--------------------------------------------------------------
. use "${f_drama}", clear

. capture drop treat_post

. generate double treat_post = treat_50km * post_50km

. forvalues k = 0/3 {
  2.     if `k' == 0  local rv "review"
  3.     else         local rv "review`k'"
  4.     capture drop tp_x
  5.     generate double tp_x = treat_post * `rv'
  6.     reghdfe divorce_rate tp_x treat_post `rv' $cv, ///
>         absorb(year county_code) cluster(county_code)
  7.     post_est, label("T3_youku_`rv'") coef(tp_x)
  8.     drop tp_x
  9. }
