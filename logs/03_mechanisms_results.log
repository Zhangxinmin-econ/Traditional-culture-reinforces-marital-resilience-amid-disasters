. *--------------------------------------------------------------
. * S10-S12  CHARLS 心理 / 认知 / 生理
. *--------------------------------------------------------------
. foreach item in "cesd10" "satlife" "hope" "total_cognition" "memeory" ///
>                 "executive" "sleep" "bl_crp" "pulse" "systo" "diasto" {
  2.     local fname "`item' .dta"
  3.     if "`item'" == "pulse" local fname "pulse.dta"
  4.     use "${d_charls}/`fname'", clear
  5.     capture drop tp
  6.     generate double tp = treat_50km * post_50km
  7.     if "`item'" == "sleep" {
  8.         reghdfe sleep tp $cv_charls if sleep > 6, absorb(city year) vce(cluster city)
  9.     }
 10.     else if "`item'" == "bl_crp" {
 11.         reghdfe bl_crp tp $cv_charls if bl_crp >= 0.1 & bl_crp <= 200, ///
>             absorb(city year) vce(cluster city)
 12.     }
 13.     else {
 14.         reghdfe `item' tp $cv_charls, absorb(city year) vce(cluster city)
 15.     }
 16.     post_est, label("S10_12_charls_`item'") coef(tp)
 17. }
